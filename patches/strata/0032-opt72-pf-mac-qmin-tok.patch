+// reads of EVERY cold expert 3 layers ahead; it reads only the experts it routes to, on demand at each layer (fewer bytes, not overlapped).
+// At ~1000 tokens a chunk routes to ~220 cold experts per layer, about half of them in the Mac LRU; the read-ahead reads all ~223 the LRU lacks.
+static int64_t pf_mac_qmin_tok() {
+    static const int64_t v = [] { const char* e = std::getenv("STRATA_PF_MAC_QMIN_TOK"); return e != nullptr && std::atoll(e) > 0 ? (int64_t) std::atoll(e) : (int64_t) 0; }();
+    return v;
+}
