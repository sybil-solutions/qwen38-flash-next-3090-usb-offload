+// the lag without a restart.  pair=1 turns the shared jobs off, pair=N (2..STRATA_PF_PAIR) caps them at N chunks; g=N caps the group at N chunks; mc = min chunks, div = the tokens per chunk below which mc is not forced (512).
+struct PfDyn { std::atomic<int> mc{-1}, div{-1}, pair{-1}, g{-1}, lag{-2}; };
+inline PfDyn& pf_dyn() { static PfDyn d; return d; }
+inline void pf_dyn_refresh() {
+    static const char* path = std::getenv("STRATA_PF_CFG");
+    PfDyn& d = pf_dyn();
+    d.mc = -1; d.div = -1; d.pair = -1; d.g = -1; d.lag = -2;
+    if (path == nullptr) return;
+    FILE* f = std::fopen(path, "r");
+    if (f == nullptr) return;
+    char k[16]; int v = 0;
+    while (std::fscanf(f, " %15[a-z]=%d", k, &v) == 2) {
+        if (!std::strcmp(k, "mc")) d.mc = v; else if (!std::strcmp(k, "div")) d.div = v; else if (!std::strcmp(k, "pair")) d.pair = v; else if (!std::strcmp(k, "g")) d.g = v; else if (!std::strcmp(k, "lag")) d.lag = v;
+    }
+    std::fclose(f);
+}
+// Prefill20: STRATA_PF_PAIR=N (N >= 2) makes the job an N-chunk job (1 = the pair, 2 chunks): the job's fixed cost (decode of every cold expert's weights, ~37 ms for 290 experts on the M4) is paid once per N
+// chunks.  A lockstep group of G chunks is cut into ceil(G / N) consecutive jobs of as even a size as possible (G = 6, N = 3: 3 + 3).  A job of s chunks needs lag >= s (split) / s - 1 (plain).
+inline int pf_pair_env() {
+    static const int v = [] { const char* e = std::getenv("STRATA_PF_PAIR"); const int n = e ? std::atoi(e) : 0; return n <= 0 ? 0 : (n == 1 ? 2 : std::clamp(n, 2, 8)); }();
+    return v;
+}
+inline int pf_pair_k() {
+    const int e = pf_pair_env(), dv = pf_dyn().pair;
+    if (dv < 0 || e == 0) return e;
+    return dv <= 1 ? 0 : std::min(dv, e);
 }
+inline bool pf_pair() { return pf_pair_k() >= 2; }
