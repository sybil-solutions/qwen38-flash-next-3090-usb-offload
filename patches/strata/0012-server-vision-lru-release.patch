+    def lru_mib(self, mib: int, timeout: float = 120.0) -> int:
+        """Decode7: `LRUMIB <mib>` between requests (the caller holds the service's FIFO): the engine gives <mib> MiB of its mini-side expert LRU back to the OS (the vision encoder's RAM + Metal working set), or
+        all of it again with 0 (the regained slots are warmed by profile rank).  -> the LRU slots in use; raises ValueError with the engine's reason, EngineDied when it ended."""
+        if not self.alive():
+            raise EngineDied("the engine is not running")
+        self.proc.stdin.write(f"LRUMIB {int(mib)}\n")
+        self.proc.stdin.flush()
+        deadline = time.time() + timeout
+        while True:
+            try:
+                line = self.lines.get(timeout=max(0.1, deadline - time.time()))
+            except queue.Empty:
+                raise EngineDied("the engine did not answer the LRUMIB command") from None
+            if line is None:
+                raise EngineDied("the engine ended")
+            line = line.strip()
+            if line.startswith("ERR"):
+                raise ValueError(line[4:].strip() or "the engine refused the LRUMIB command")
+            if line.startswith("LRUMIB "):
+                return int(line.split()[1])
+            if time.time() > deadline:
+                raise EngineDied("the engine did not answer the LRUMIB command")
+
