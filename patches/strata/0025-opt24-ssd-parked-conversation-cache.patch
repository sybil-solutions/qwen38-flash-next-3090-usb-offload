     // O_DIRECT is switched on the open descriptor: a filesystem that refuses it (EINVAL, e.g. tmpfs) keeps buffered
     // I/O, and the file is never opened twice
     void try_direct() {
+#if defined(__APPLE__)
+        // macOS has no O_DIRECT: F_NOCACHE keeps a parked conversation's gigabyte out of the unified buffer cache (the
+        // experts' page-cache hits live there); no alignment is required, so `direct_` stays false
+        if (!buffered_forced()) (void) ::fcntl(fd_, F_NOCACHE, 1);
+        return;
+#endif
         if (O_DIRECT == 0 || buffered_forced()) return;
         const int fl = ::fcntl(fd_, F_GETFL);
         direct_ = fl >= 0 && ::fcntl(fd_, F_SETFL, fl | O_DIRECT) == 0;
