+namespace xq_emu {
+inline void wht32(float* v) {   // orthonormal: H / sqrt(32), its own inverse
+    for (int h = 1; h < 32; h <<= 1)
+        for (int i = 0; i < 32; i += h << 1)
+            for (int j = i; j < i + h; ++j) { const float a = v[j], b = v[j + h]; v[j] = a + b; v[j + h] = a - b; }
+    for (int i = 0; i < 32; ++i) v[i] *= 0.17677669529663687f;
