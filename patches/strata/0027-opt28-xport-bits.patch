+    const float qmax = (float) ((1 << (j.bits - 1)) - 1);
+    for (int64_t b = b0; b < b1; ++b) {
+        uint16_t* xb = j.x + b * 32;
+        float v[32];
+        for (int i = 0; i < 32; ++i) { _Float16 h; std::memcpy(&h, &xb[i], 2); v[i] = (float) h; }
