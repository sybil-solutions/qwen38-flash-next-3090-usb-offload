+// Opt28 b-bit form (STRATA_PF_XPORT_BITS = 4..7; format: include/strata/prefill/xport8.hpp).  quant: one warp per block, the same arithmetic as quant_kernel with
+// qmax = 2^(B-1) - 1; lane w < B assembles word w of the block's bit stream from the codes of the lanes that overlap it (warp shuffles).  dequant: one thread per value.
+template <int B>
+__global__ void quantb_kernel(const uint16_t* __restrict__ x, uint32_t* __restrict__ wq, uint16_t* __restrict__ sc, int64_t nb) {
+    const int64_t b = ((int64_t) blockIdx.x * blockDim.x + threadIdx.x) >> 5;
+    if (b >= nb) return;   // whole warps leave together
+    constexpr int QM = (1 << (B - 1)) - 1;
+    const int lane = threadIdx.x & 31;
+    const float v = __half2float(__ushort_as_half(x[b * 32 + lane]));
+    float a = fabsf(v);
+    a = (a == a) ? a : 0.0f;
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) a = fmaxf(a, __shfl_xor_sync(0xffffffffu, a, o));
+    const uint16_t sh = __half_as_ushort(__float2half_rn(__fdiv_rn(a, (float) QM)));
+    const float sf = __half2float(__ushort_as_half(sh));
+    int qi = 0;
+    if (sf != 0.0f) { qi = __float2int_rn(__fdiv_rn(v, sf)); qi = min(max(qi, -QM), QM); }
+    const uint32_t c = (uint32_t) (qi + QM);
+    const int i0 = (32 * lane) / B, i1 = (32 * lane + 31) / B;   // lanes whose bits overlap word `lane` (meaningful for lane < B)
+    uint32_t word = 0;
+#pragma unroll
+    for (int j = 0; j < 32 / B + 2; ++j) {
+        const int src = min(i0 + j, 31);
+        const uint32_t cv = __shfl_sync(0xffffffffu, c, src);
+        if (lane < B && i0 + j <= i1) {
+            const int s = src * B - 32 * lane;
+            word |= s >= 0 ? (cv << s) : (cv >> -s);
+        }
+    }
+    if (lane < B) wq[b * B + lane] = word;
+    if (lane == 0) sc[b] = sh;
+}
+template <int B>
+__global__ void dequantb_kernel(const uint32_t* __restrict__ wq, const uint16_t* __restrict__ sc, uint16_t* __restrict__ out, int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    constexpr int QM = (1 << (B - 1)) - 1;
+    const int64_t b = i >> 5;
+    const int p = (int) (i & 31) * B, w = p >> 5, s = p & 31;
+    const uint32_t* wb = wq + b * B;
+    uint32_t bits = wb[w] >> s;
+    if (s + B > 32) bits |= wb[w + 1] << (32 - s);
+    const int c = (int) (bits & ((1u << B) - 1u));
+    float v = (float) (c - QM) * __half2float(__ushort_as_half(sc[b]));
+    v = fminf(fmaxf(v, -65504.0f), 65504.0f);
+    out[i] = __half_as_ushort(__float2half_rn(v));
+}
+inline int xport_bits() {   // host side; same variable and parse as xport8.hpp
+    static const int v = [] { const char* e = std::getenv("STRATA_PF_XPORT_BITS"); const int b = e ? std::atoi(e) : 8; return b >= 4 && b <= 7 ? b : 8; }();
+    return v;
+}
+template <int B>
+inline void launch_quantb(const uint16_t* x16, uint8_t* out, int64_t n, cudaStream_t stream) {
+    const int64_t nb = n / 32;
+    quantb_kernel<B><<<(unsigned) ((nb * 32 + 255) / 256), 256, 0, stream>>>(x16, reinterpret_cast<uint32_t*>(out), reinterpret_cast<uint16_t*>(out + (size_t) nb * 4 * B), nb);
+}
+template <int B>
+inline void launch_dequantb(const uint8_t* in, uint16_t* out16, int64_t n, cudaStream_t stream) {
+    const int64_t nb = n / 32;
+    dequantb_kernel<B><<<(unsigned) ((n + 255) / 256), 256, 0, stream>>>(reinterpret_cast<const uint32_t*>(in), reinterpret_cast<const uint16_t*>(in + (size_t) nb * 4 * B), out16, n);
+}
