+// ---- Opt23 (STRATA_O23: bit 0 = fp16 x, bit 1 = device skip; needs STRATA_EXL3_SLIM=1 and STRATA_HS_PRE=1).  The EXL3 slim doorbell publishes into per-ring payload slots (the device may run ahead through rings with no cold expert),
+// x rounded to fp16 (the Metal lane rounds x to fp16 first, so this is bit-exact and halves the pulled bytes), and the device skips the wait for the host's rows (wait_flag_ge_or) when no routed expert of the
+// ring is outside VRAM; the host reads that decision from the payload (aux[ring]) and sends no flag.  Kernel: libstrata_o23.dylib (STRATA_O23_LIB, ~/strata-opt23/lib/exl3_o23.cu).
+struct O23 {
+    bool ok = false, xh = false, skip = false, yh = false;
+    uint16_t *h_yh = nullptr, *m_yh = nullptr;   // fp16 y rows (host -> device), the device adds and re-zeroes them
+    int (*add_h)(float*, uint16_t*, int, void*) = nullptr;
+    int max_t = 0, rings = 0; int64_t N = 0, K = 0;
+    float *h_xf = nullptr, *m_xf = nullptr; uint16_t *h_xh = nullptr, *m_xh = nullptr;
+    int32_t *h_ids = nullptr, *m_ids = nullptr; float *h_w = nullptr, *m_w = nullptr; int32_t *h_aux = nullptr, *m_aux = nullptr;
+    uint32_t* d_skip = nullptr;
+    int (*doorbell)(const float*, int, const int32_t*, const float*, int, const int32_t*, int, void*, int, int32_t*, float*, int32_t*, uint32_t*, uint32_t, uint32_t*, void*) = nullptr;
+    long long n_rings = 0, n_skipped = 0, n_disagree = 0;
+    void* m_x_slot(int64_t slot, int tb) const { const size_t o = (size_t) slot * (size_t) max_t * (size_t) N + (size_t) tb * (size_t) N; return xh ? (void*) (m_xh + o) : (void*) (m_xf + o); }
+    int segs(int64_t slot, int tb, int n, void** ps, size_t* ns) const {   // the host buffers of one ring's pull: x (fp16 or fp32), ids, w[, aux]
+        const size_t xo = (size_t) slot * (size_t) max_t * (size_t) N + (size_t) tb * (size_t) N, io = (size_t) slot * (size_t) max_t * (size_t) K + (size_t) tb * (size_t) K;
+        int c = 0;
+        if (xh) { ps[c] = h_xh + xo; ns[c] = (size_t) n * (size_t) N * 2; } else { ps[c] = h_xf + xo; ns[c] = (size_t) n * (size_t) N * 4; }
+        ++c;
+        ps[c] = h_ids + io; ns[c] = (size_t) n * (size_t) K * 4; ++c;
+        ps[c] = h_w + io; ns[c] = (size_t) n * (size_t) K * 4; ++c;
+        if (skip) { ps[c] = h_aux + slot; ns[c] = 4; ++c; }
+        return c;
+    }
+};
+std::unordered_map<const void*, O23>& o23_map() { static std::unordered_map<const void*, O23> m; return m; }
+O23* o23_of(const void* key) { auto& m = o23_map(); auto it = m.find(key); return it != m.end() && it->second.ok ? &it->second : nullptr; }
+bool o23_init(const void* key, int max_t, int64_t N, int64_t K, int64_t layers, std::string& err) {
+    const char* e = std::getenv("STRATA_O23");
+    const int mode = e ? std::atoi(e) : 0;
+    if (mode == 0) return true;
+    const char* hp = std::getenv("STRATA_HS_PRE");
+    if (!(hp && std::atoi(hp) != 0) || max_t < 2 || max_t > 8 || (N & 1) != 0) { std::fprintf(stderr, "strata o23: needs STRATA_HS_PRE=1 and a 2..8 token window: off\n"); return true; }
+    O23 o;
+    const char* lp = std::getenv("STRATA_O23_LIB");
+    const char* home = std::getenv("HOME");
+    const std::string path = lp ? lp : std::string(home ? home : "") + "/strata-opt23/lib/libstrata_o23.dylib";
+    void* h = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!h) { err = "o23: dlopen " + path + ": " + dlerror(); return false; }
+    o.doorbell = (decltype(o.doorbell)) dlsym(h, "exl3o_doorbell");
+    o.add_h = (decltype(o.add_h)) dlsym(h, "exl3o_add_h");
+    if (!o.doorbell || (o.yh && !o.add_h)) { err = "o23: " + path + " lacks exl3o_doorbell / exl3o_add_h"; return false; }
+    o.xh = (mode & 1) != 0; o.skip = (mode & 2) != 0; o.yh = (mode & 4) != 0; o.max_t = max_t; o.rings = (int) layers; o.N = N; o.K = K;
+    const size_t R = (size_t) layers, T = (size_t) max_t;
+    bool ok = (o.xh ? mapped(R * T * (size_t) N * 2, (void**) &o.h_xh, (void**) &o.m_xh) : mapped(R * T * (size_t) N * 4, (void**) &o.h_xf, (void**) &o.m_xf)) &&
+              mapped(R * T * (size_t) K * 4, (void**) &o.h_ids, (void**) &o.m_ids) && mapped(R * T * (size_t) K * 4, (void**) &o.h_w, (void**) &o.m_w) &&
+              mapped(R * 4 + 64, (void**) &o.h_aux, (void**) &o.m_aux) &&
+              (!o.yh || (mapped(T * (size_t) N * 2, (void**) &o.h_yh, (void**) &o.m_yh) && (strata::tgcu::push(o.h_yh, T * (size_t) N * 2), true))) &&
+              cudaMalloc((void**) &o.d_skip, 64) == cudaSuccess && cudaMemset(o.d_skip, 0, 64) == cudaSuccess;
+    if (!ok) { err = "o23: payload slot allocation failed"; return false; }
+    o.ok = true;
+    std::fprintf(stderr, "strata o23: per-ring payload slots (%zu rings x %d rows), x as %s, device skip %s, y as %s, lib %s\n", R, max_t, o.xh ? "fp16" : "fp32", o.skip ? "on" : "off", o.yh ? "fp16" : "fp32", path.c_str());
+    o23_map()[key] = o;
+    return true;
+}
