+inline PfMoeTok pf_moe_tok(const void* any_sym) {
+    static PfMoeTok fn = [any_sym]() -> PfMoeTok {
+        Dl_info di{};
+        if (any_sym == nullptr || dladdr(any_sym, &di) == 0 || di.dli_fname == nullptr) return nullptr;
